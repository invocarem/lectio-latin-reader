{
  "name": "lectio-latin-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "content": "python3 scripts/merge_english.py",
    "cap:sync": "npm run build && npx cap sync ios",
    "ios": "npm run cap:sync && npx cap open ios",
    "lexicon:extract": "python3 scripts/extract_wordlist.py",
    "lexicon:analyze": "bash scripts/analyze-in-docker.sh",
    "lexicon:parse": "python3 scripts/parse_analyses.py",
    "lexicon:curate": "python3 scripts/apply_overrides.py"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
